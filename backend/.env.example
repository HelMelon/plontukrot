# Database connection string
DATABASE_URL=postgresql://plontukrot:***@127.0.0.1:5432/plontukrot

# JWT Authentication
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Public URL and media
PUBLIC_BASE_URL=http://127.0.0.1:8000
PHOTOS_DIR=/opt/plontukrot/photos

# AI Botanical Care Guides (DeepSeek / Gemini / YandexGPT / OpenAI)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
