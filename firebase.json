{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "plant-logger-e0677",
          "appId": "1:577871492679:android:e4bbb5e19ffa095e566362",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "plant-logger-e0677",
          "configurations": {
            "android": "1:577871492679:android:e4bbb5e19ffa095e566362",
            "ios": "1:577871492679:ios:dffbd79ef2a93825566362",
            "macos": "1:577871492679:ios:dffbd79ef2a93825566362",
            "web": "1:577871492679:web:9ae1872d4d3d4951566362",
            "windows": "1:577871492679:web:055f2744a07cc60f566362"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|wasm|jpg|jpeg|gif|png|svg|webp|woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
