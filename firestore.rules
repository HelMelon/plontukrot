rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFriendOf(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid));
    }

    function collectionVisibleToFriends(userId) {
      return !('collectionVisibility' in get(/databases/$(database)/documents/users/$(userId)).data)
        || get(/databases/$(database)/documents/users/$(userId)).data.collectionVisibility == 'friends';
    }

    match /users/{userId} {
      // Owner full access; friends may read profile for display names.
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow write: if isOwner(userId);

      match /friends/{friendUid} {
        allow read: if isOwner(userId) || request.auth.uid == friendUid;
        allow create, delete: if isOwner(userId)
          || (isSignedIn() && request.auth.uid == friendUid);
        allow update: if isOwner(userId);
      }

      match /friendRequests/{requestId} {
        allow read: if isOwner(userId)
          || (isSignedIn()
            && (resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid));
        allow create: if isSignedIn()
          && request.resource.data.fromUid is string
          && request.resource.data.toUid is string
          && request.resource.data.status == 'pending'
          && (
            (isOwner(userId) && request.resource.data.fromUid == request.auth.uid)
            || (request.resource.data.toUid == userId
              && request.resource.data.fromUid == request.auth.uid)
          );
        allow update: if isSignedIn()
          && (
            isOwner(userId)
            || resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
          );
        allow delete: if isSignedIn()
          && (
            isOwner(userId)
            || resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
          );
      }

      match /incomingGifts/{giftId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.fromUid == request.auth.uid);
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && isFriendOf(userId)
          && request.resource.data.status == 'pending';
        allow update: if isOwner(userId)
          || (isSignedIn() && resource.data.fromUid == request.auth.uid);
        allow delete: if isOwner(userId)
          || (isSignedIn() && resource.data.fromUid == request.auth.uid);
      }

      match /outgoingGifts/{giftId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
        allow create: if isOwner(userId)
          && request.resource.data.status == 'pending';
        allow update: if isOwner(userId)
          || (isSignedIn()
            && resource.data.recipientUid == request.auth.uid
            && request.resource.data.recipientUid == resource.data.recipientUid
            && request.resource.data.plantId == resource.data.plantId);
        allow delete: if isOwner(userId);
      }

      // Friends may list plants when collection is friends-visible (UI hides archived).
      match /plants/{plantId} {
        allow read: if isOwner(userId)
          || (isFriendOf(userId) && collectionVisibleToFriends(userId));
        allow write: if isOwner(userId);

        match /{subcollection}/{docId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);

        match /{subcollection}/{subDocId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    match /plantSpecies/{speciesId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.species is string
        && request.resource.data.species.size() > 0
        && request.resource.data.genus is string
        && (!('plantFamily' in request.resource.data)
            || request.resource.data.plantFamily == null
            || request.resource.data.plantFamily is string);

      allow update, delete: if false;
    }
  }
}
