rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Per-user app data (plants, care history, catalogs, propagations, …)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Shared botanical catalog — authenticated read; create-only from clients
    match /plantSpecies/{speciesId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.species is string
        && request.resource.data.species.size() > 0
        && request.resource.data.genus is string
        && (!('plantFamily' in request.resource.data)
            || request.resource.data.plantFamily == null
            || request.resource.data.plantFamily is string);

      allow update, delete: if false;
    }
  }
}
