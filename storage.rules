rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidJpegWrite(fileName) {
      return fileName.matches('.*\\.jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // Legacy cover: plants/{uid}/{plantId}.jpg and *_thumb.jpg
    match /plants/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidJpegWrite(fileName);
      allow delete: if isOwner(userId);
    }

    // Gallery: plants/{uid}/{plantId}/{photoId}.jpg and *_thumb.jpg
    match /plants/{userId}/{plantId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidJpegWrite(fileName);
      allow delete: if isOwner(userId);
    }
  }
}
